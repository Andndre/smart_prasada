{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "the-i18n-mcp": {
            "command": "npx",
            "args": [
                "-y",
                "the-i18n-mcp@latest"
            ]
        }
    }
}
